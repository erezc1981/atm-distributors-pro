rules_version = '2';

// כללי אבטחה ל-Cloud Firestore של atm-distributors-pro
// פריסה: firebase deploy --only firestore:rules --project atm-distributors-pro
// (מנוע הסנכרון עובד עם Service Account ולכן לא מושפע מהכללים האלה)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function nowMs() {
      return request.time.toMillis();
    }

    // מנהל המערכת (הבעלים) - מנהל מנויים של כל המפיצים
    function isAdmin() {
      return signedIn() && request.auth.uid == 'TblW8UHDSBTh91BCJcqo3YKEqQJ3';
    }

    function emailVerified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // עובד ששויך למפיץ uid
    function isDriverOf(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.distributorUid == uid;
    }

    function ownerOrDriver(uid) {
      return isOwner(uid) || isDriverOf(uid);
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/distributors/$(uid)).data;
    }

    // מנוי בתוקף: בעלים / מנוי פעיל / ניסיון שלא פג
    function hasValidSub(uid) {
      let p = profile(uid);
      return p.get('plan', '') == 'owner_free'
        || (p.get('subscriptionStatus', '') == 'active'
            && (p.get('currentPeriodEnd', null) == null || nowMs() <= p.get('currentPeriodEnd', 0)))
        || (p.get('subscriptionStatus', '') == 'trial'
            && nowMs() <= p.get('trialEndsAt', 0));
    }

    // RSA-3072 מוצפן ב-Base64 הוא בדיוק 512 תווים
    function validPasswordEnc(v) {
      return v is string && v.size() == 512 && v.matches('^[A-Za-z0-9+/=]+$');
    }

    function validRoute(d) {
      return d.days is list && d.days.size() <= 7
        && (!('calcModes' in d) || (d.calcModes is map && d.calcModes.size() <= 6));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validNotes(d) {
      return !('notes' in changedKeys()) || (d.notes is string && d.notes.size() <= 500);
    }

    match /distributors/{uid} {
      // עובד קורא את הפרופיל כדי לדעת אם המנוי של המפיץ בתוקף
      allow read: if ownerOrDriver(uid) || isAdmin();

      // הרשמה: רק פרופיל ניסיון של עד 30 יום, עם זמן יצירה אמיתי ואישור תנאי שימוש
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'subscriptionStatus', 'createdAt', 'trialEndsAt', 'termsAcceptedAt', 'termsVersion', 'referredBy'])
        // חבר מביא חבר: מזהה המפיץ שהזמין (לא את עצמו)
        && (!('referredBy' in request.resource.data) || (request.resource.data.referredBy is string
            && request.resource.data.referredBy.size() >= 10 && request.resource.data.referredBy.size() <= 40
            && request.resource.data.referredBy != uid))
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.createdAt is int
        && request.resource.data.trialEndsAt is int
        && request.resource.data.createdAt > nowMs() - 3600000
        && request.resource.data.createdAt < nowMs() + 3600000
        && request.resource.data.trialEndsAt <= request.resource.data.createdAt + 30 * 86400000
        && (!('termsVersion' in request.resource.data) || (request.resource.data.termsVersion is string && request.resource.data.termsVersion.size() <= 20))
        && (!('termsAcceptedAt' in request.resource.data) || request.resource.data.termsAcceptedAt is int)
        // עובד שכבר שויך למפיץ לא פותח חשבון מפיץ
        && !exists(/databases/$(database)/documents/memberships/$(request.auth.uid));

      // המשתמש לא יכול לשנות לעצמו מנוי/ניסיון/תוכנית - רק בקשת שדרוג
      allow update: if (isOwner(uid)
        && changedKeys().hasOnly(['upgradeRequest', 'email']))
        || (isAdmin()
        && changedKeys().hasOnly(['subscriptionStatus', 'currentPeriodEnd', 'plan', 'trialEndsAt', 'upgradeRequest',
                                  'referralRewardedAt', 'referralCount', 'referralYear', 'referralYearCount'])
        && (request.resource.data.get('referralCount', 0) is int)
        && (request.resource.data.get('referralYearCount', 0) is int)
        && request.resource.data.get('subscriptionStatus', 'trial') in ['trial', 'active', 'canceled']
        && (request.resource.data.get('currentPeriodEnd', null) == null || request.resource.data.currentPeriodEnd is int)
        && (request.resource.data.get('trialEndsAt', null) == null || request.resource.data.trialEndsAt is int)
        && request.resource.data.get('plan', '') in ['', 'monthly', 'yearly', 'owner_free']);

      allow delete: if false;

      // היסטוריית תשלומים: המנהל רושם, המפיץ רואה. אין עריכה או מחיקה.
      match /payments/{pid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['amount', 'plan', 'periodEnd', 'paidAt', 'note'])
          && request.resource.data.amount is number && request.resource.data.amount >= 0
          && request.resource.data.plan in ['monthly', 'yearly', 'other']
          && request.resource.data.periodEnd is int
          && request.resource.data.paidAt is int
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200));
        allow update, delete: if false;
      }

      match /terminals/{tid} {
        allow read: if ownerOrDriver(uid);
        // מסופים נוצרים ע"י הסנכרון בלבד
        allow create, delete: if false;
        // מפיץ: כל שדות הניהול. עובד: רק הטענה, נייר והערות.
        allow update: if hasValidSub(uid) && (
          (isOwner(uid)
            && changedKeys().hasOnly([
                 'sector', 'paperRollNeeded', 'threshold', 'notes', 'baseTargetK',
                 'refilled', 'lastRefilledAt', 'lastRefillId', 'hidden', 'order'
               ])
            && validNotes(request.resource.data)
            && (!('threshold' in changedKeys()) || (request.resource.data.threshold is number && request.resource.data.threshold >= 0))
            && (!('baseTargetK' in changedKeys()) || request.resource.data.baseTargetK == null
                || (request.resource.data.baseTargetK is number && request.resource.data.baseTargetK >= 0 && request.resource.data.baseTargetK <= 1000))
            && (!('sector' in changedKeys()) || request.resource.data.sector in ['jewish', 'arab', 'none'])
            && (!('hidden' in changedKeys()) || request.resource.data.hidden is bool)
            && (!('order' in changedKeys()) || (request.resource.data.order is int && request.resource.data.order >= 0 && request.resource.data.order <= 10000)))
          || (isDriverOf(uid)
            && changedKeys().hasOnly(['paperRollNeeded', 'notes', 'refilled', 'lastRefilledAt', 'lastRefillId'])
            && validNotes(request.resource.data))
        );
      }

      // היסטוריית הטענות: נרשמת ע"י המפיץ או העובד, לא ניתנת לעריכה
      match /refills/{rid} {
        allow read: if ownerOrDriver(uid);
        allow create: if ownerOrDriver(uid)
          && hasValidSub(uid)
          && request.resource.data.keys().hasOnly(['terminalId', 'terminalName', 'amount', 'balanceBefore', 'at', 'byUid', 'byEmail', 'byName'])
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.terminalId is string && request.resource.data.terminalId.size() <= 40
          && request.resource.data.terminalName is string && request.resource.data.terminalName.size() <= 80
          && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000
          && request.resource.data.at is int
          // הטענה שנרשמה בלי קליטה נשלחת מאוחר יותר - עד 7 ימים אחורה
          && request.resource.data.at > nowMs() - 7 * 86400000
          && request.resource.data.at < nowMs() + 600000
          && request.resource.data.byEmail is string && request.resource.data.byEmail.size() <= 120
          && (!('byName' in request.resource.data) || (request.resource.data.byName is string && request.resource.data.byName.size() <= 60));
        allow update: if false;
        // ביטול רישום: המפיץ תמיד, העובד רק את שלו ותוך 12 שעות
        allow delete: if isOwner(uid)
          || (isDriverOf(uid) && resource.data.byUid == request.auth.uid && resource.data.at > nowMs() - 12 * 3600000);
      }

      // היסטוריה יומית (נכתבת ע"י מנוע הסנכרון): בסיס למגמות ותחזיות
      match /daily/{day} {
        allow read: if ownerOrDriver(uid);
        allow write: if false;
      }

      // התראות וואטסאפ: מספר טלפון + הפעלה/כיבוי
      match /settings/alerts {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && hasValidSub(uid)
          && request.resource.data.keys().hasOnly(['phone', 'enabled', 'updatedAt'])
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 20
          && request.resource.data.phone.matches('^[0-9+]*$')
          && request.resource.data.enabled is bool;
      }

      // ימי קו + מצבי חישוב (חג/רמדאן וכו'). עדכון בודק רק את השדות שמשתנים,
      // כך שמסמך ישן עם שדות נוספים (activeDays) לא חוסם שמירה.
      match /settings/route {
        allow read: if ownerOrDriver(uid);
        allow create: if isOwner(uid)
          && hasValidSub(uid)
          && request.resource.data.keys().hasOnly(['days', 'updatedAt', 'calcModes'])
          && validRoute(request.resource.data);
        allow update: if isOwner(uid)
          && hasValidSub(uid)
          && changedKeys().hasOnly(['days', 'updatedAt', 'calcModes'])
          && validRoute(request.resource.data);
      }

      match /settings/cas_sync {
        allow read: if isOwner(uid) || isAdmin();  // המנהל רואה סטטוס סנכרון לצורך תמיכה
        // passwordEnc = סיסמה מוצפנת בדפדפן (RSA-OAEP, Base64); אין שדה סיסמה גלויה
        // חיבור פרטי כספונט (שם משתמש/סיסמה) דורש אימייל מאומת
        allow create: if isOwner(uid)
          && hasValidSub(uid)
          && request.resource.data.keys()
               .hasOnly(['username', 'passwordEnc', 'syncRequested', 'syncRequestedAt', 'updatedAt', 'lastSyncError'])
          && (!('lastSyncError' in request.resource.data) || request.resource.data.lastSyncError == '')
          && (!('passwordEnc' in request.resource.data) || validPasswordEnc(request.resource.data.passwordEnc))
          && (!('username' in request.resource.data) || emailVerified() || isAdmin());
        allow update: if isOwner(uid)
          && hasValidSub(uid)
          && changedKeys()
               .hasOnly(['username', 'passwordEnc', 'syncRequested', 'syncRequestedAt', 'updatedAt', 'lastSyncError'])
          && (!('lastSyncError' in changedKeys()) || request.resource.data.lastSyncError == '')
          && (!('passwordEnc' in changedKeys()) || validPasswordEnc(request.resource.data.passwordEnc))
          && ((!('passwordEnc' in changedKeys()) && !('username' in changedKeys())) || emailVerified() || isAdmin());
        allow delete: if false;
      }

      // alert_state, reminders ומסמכים אחרים - שרת בלבד
      match /settings/{other} {
        allow read: if isOwner(uid) && !(other in ['alert_state', 'reminders']);
        allow write: if false;
      }
    }

    // הזמנת עובד: מזהה המסמך = אימייל העובד באותיות קטנות
    match /invites/{email} {
      allow read: if signedIn() && (resource.data.distributorUid == request.auth.uid || myEmail() == email);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['distributorUid', 'distributorEmail', 'name', 'createdAt'])
        && request.resource.data.distributorUid == request.auth.uid
        && exists(/databases/$(database)/documents/distributors/$(request.auth.uid))
        && hasValidSub(request.auth.uid)
        && (emailVerified() || isAdmin())
        && email != myEmail()
        && email.size() <= 120
        && request.resource.data.distributorEmail is string && request.resource.data.distributorEmail.size() <= 120
        && request.resource.data.createdAt is int
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
      // הזמנה קיימת של מפיץ אחר לא נדרסת
      allow update: if false;
      allow delete: if signedIn() && (resource.data.distributorUid == request.auth.uid || myEmail() == email);
    }

    // שיוך עובד למפיץ: נוצר ע"י העובד עצמו, רק עם אימייל מאומת והזמנה תואמת
    match /memberships/{driverUid} {
      allow read: if signedIn() && (request.auth.uid == driverUid || resource.data.distributorUid == request.auth.uid || isAdmin());
      allow create: if request.auth.uid == driverUid
        && emailVerified()
        && request.resource.data.keys().hasOnly(['distributorUid', 'distributorEmail', 'email', 'name', 'role', 'joinedAt'])
        && request.resource.data.role == 'driver'
        && request.resource.data.email.lower() == myEmail()
        && request.resource.data.joinedAt is int
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && get(/databases/$(database)/documents/invites/$(myEmail())).data.distributorUid == request.resource.data.distributorUid
        // השם נלקח מההזמנה של המפיץ (העובד לא בוחר לעצמו שם אחר)
        && request.resource.data.get('name', '') == get(/databases/$(database)/documents/invites/$(myEmail())).data.get('name', '')
        // מפיץ עם חשבון משלו לא הופך לעובד
        && !exists(/databases/$(database)/documents/distributors/$(request.auth.uid));
      // המפיץ יכול לשנות רק את שם העובד
      allow update: if signedIn() && resource.data.distributorUid == request.auth.uid
        && changedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && (request.auth.uid == driverUid || resource.data.distributorUid == request.auth.uid);
    }

    // הערות פנימיות של המנהל על מפיצים - רק המנהל
    match /adminNotes/{uid} {
      allow read, write: if isAdmin();
    }

    // דופק מנוע הסנכרון - נכתב ע"י השרת, נקרא ע"י המנהל
    match /system/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // כל השאר חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
